# --- Server ---
PORT=8080
# debug | release | test
GIN_MODE=debug
# Comma-separated list of trusted proxy IPs/CIDRs (leave empty if not behind reverse proxy/load balancer)
TRUSTED_PROXIES=

# --- Security & CORS ---
# Comma-separated list of allowed origins (e.g. https://myfrontend.com,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Cookies ---
# true | false (defaults to true if GIN_MODE=release)
COOKIE_SECURE=false
# Lax | Strict | None
COOKIE_SAME_SITE=Lax
# Cookie domain (leave empty for current domain)
COOKIE_DOMAIN=

# --- PostgreSQL (required) ---
DATABASE_URL=host=localhost user=postgres password=password dbname=mydb port=5432 sslmode=disable

# --- Redis (required; used for rate limiting) ---
# host:port
REDIS_URL=localhost:6379
